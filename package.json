{
	"name": "front-end-uk",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"format": "prettier \"*/**/*.{js,jsx,ts,tsx,json,md,css,scss}\" --write",
		"formatw": "prettier \"{,!(node_modules)/**/}*.js\"",
		"lint": "run-p lint:*",
		"lint:js": "eslint \"*/**/*.{js,jsx,ts,tsx}\" --fix",
		"lint:css": "stylelint \"./**/*.{css,scss}\" --fix",
		"lint:ts": "tsc -p tsconfig.json --noEmit && npm run typecheck",
		"new:c": "cross-env HYGEN_TMPLS=generators hygen new component",
		"typecheck": "react-router typegen && tsc",
		"prepare": "husky",
		"start": "react-router-serve ./build/server/index.js",
		"test": "vitest",
		"test:pre-commit": "vitest run --changed",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@graphcms/html-to-slate-ast": "^0.14.2",
		"@graphcms/rich-text-react-renderer": "^0.6.2",
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@hygraph/preview-sdk": "^1.0.7",
		"@react-router/fs-routes": "^7.17.0",
		"@react-router/node": "7.17.0",
		"@react-router/serve": "7.17.0",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"isbot": "^5.1.42",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "7.17.0",
		"react-syntax-highlighter": "^16.1.1",
		"sanitize-html": "^2.17.5",
		"slate": "^0.124.1",
		"slate-hyperscript": "^0.125.0"
	},
	"devDependencies": {
		"@axe-core/react": "^4.11.3",
		"@chromatic-com/storybook": "^5.2.1",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
		"@eslint/compat": "^2.1.0",
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@react-router/dev": "7.17.0",
		"@storybook/addon-a11y": "^10.4.3",
		"@storybook/addon-docs": "^10.4.3",
		"@storybook/addon-onboarding": "^10.4.3",
		"@storybook/addon-vitest": "^10.4.3",
		"@storybook/react-vite": "^10.4.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/jest-axe": "^3.5.9",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/sanitize-html": "^2.16.1",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"@vitejs/devtools": "^0.3.1",
